# 로컬 개발 DB (docker compose up -d db)
DATABASE_URL="postgresql://app:app@localhost:5432/pickleball?schema=public"
# 통합 테스트 DB. pnpm test가 매번 이 DB를 비우고 마이그레이션한다. 이름에 "test"가 들어가야 한다.
DATABASE_URL_TEST="postgresql://app:app@localhost:5432/pickleball_test?schema=public"

# 로그인 쿠키 서명 키(16자 이상). 비우면 DATABASE_URL 에서 파생한다.
# AUTH_SECRET=""
# 카카오 로그인 연동 전 테스트 계정 로그인 (on|off)
DEMO_LOGIN="on"
# 결제: mock (토스 연동 후 toss 추가)
PAYMENT_PROVIDER="mock"
# 알림톡: console (발송 대행사 선정 후 alimtalk 추가)
NOTIFIER="console"
# /api/cron/* 호출용 Bearer 토큰(16자 이상). 비우면 크론 라우트는 401.
# CRON_SECRET=""
